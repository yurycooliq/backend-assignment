{
  "name": "backend-callback-mvp",
  "version": "1.0.0",
  "description": "Reviewer-friendly NestJS backend assignment for identity and callback ingestion.",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "corepack pnpm prisma generate",
    "prisma:migrate": "node scripts/apply-migrations.cjs",
    "prisma:migrate:deploy": "node scripts/apply-migrations.cjs",
    "test": "jest --runInBand --config jest.config.js",
    "test:e2e": "node scripts/apply-migrations.cjs && jest --runInBand --config test/jest-e2e.config.js",
    "verify": "corepack pnpm prisma generate && tsc -p tsconfig.json --noEmit && jest --runInBand --config jest.config.js && node scripts/apply-migrations.cjs && jest --runInBand --config test/jest-e2e.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "pg": "^8.16.3",
    "jest": "^30.1.3",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
